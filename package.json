    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
