    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-store": "^2.5.0",
    "codemirror": "^6.0.2",
    "manim-web": "0.40.1",
    "naive-ui": "^2.45.3",
    "pdfjs-dist": "^6.5.438",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-draggable-plus": "^0.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
